# JIRA_API_TOKEN now needs write scope: Helmsman assigns the bot
# account to a ticket and transitions it through the lifecycle statuses below.
# Non-secret keys below (adapter, AGENT_CMD, AGENT_MAX_*, PRE_PR_*, AUTO_CLAIM_INTERVAL_MS,
# REPO_PROJECT_MAP, JIRA_PROJECT/ASSIGNEE/JQL, GITHUB_REPO/PR_AUTHOR) are also
# editable at runtime from the UI (persisted as SQLite overrides). Secrets
# (GITHUB_TOKEN, JIRA_EMAIL) stay here; JIRA_API_TOKEN can also be updated in Config.
# AUTO_CLAIM_INTERVAL_MS length changes apply on restart; other edits are live.
JIRA_BASE_URL=https://godaddy-corp.atlassian.net
JIRA_EMAIL=you@godaddy.com
JIRA_API_TOKEN=
JIRA_PROJECT=AIROBUILD
JIRA_ASSIGNEE=currentUser()
# JIRA_JQL=  # optional full override of the backlog-queue query
# Jira accountId Helmsman assigns tickets to while an agent works them.
BOT_ACCOUNT_ID=
# Status names Helmsman transitions a ticket through as the agent claims and finishes it.
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_IN_REVIEW=In Review
# Status names for the Triage view's unassigned columns. Must match your board's
# actual Jira status names, which often differ from the column labels (e.g. a "To Do"
# column may map to a status literally named "Ready (To Do)").
JIRA_STATUS_BACKLOG=Backlog
JIRA_STATUS_TODO=To Do
# Retries are opt-in; 1 means no retry on failure.
AGENT_MAX_ATTEMPTS=1
# Optional overall cost cap (USD) across all retry attempts for a single run; unset/non-numeric = no cap.
AGENT_MAX_COST_USD=
# Pre-PR gate settings are captured at launch; editing Config affects new voyages only.
# Reviewer sessions per round (1–2): writer's CLI, plus the other installed supported
# CLI at 2. If only one CLI is installed, one reviewer runs. Installed failures block publication.
PRE_PR_REVIEWER_COUNT=2
# Total review rounds (1–5), including the initial round. 3 allows up to two fix rounds.
PRE_PR_MAX_ROUNDS=3
# Timeout in minutes for each implementation, fix, or reviewer session (5–180).
PRE_PR_STAGE_TIMEOUT_MINUTES=45
# How often (ms) the auto-claim scheduler checks enabled repos for new backlog work.
AUTO_CLAIM_INTERVAL_MS=60000
# AGENT_ADAPTER: codex (default) | claude-code | command
# Codex runs model 'gpt-6-astra' (astra) at medium reasoning effort by default.
# AGENT_ADAPTER=codex
# AGENT_CMD: command template for the generic adapter — {ticket} {repo} {title} placeholders
AGENT_CMD=
GITHUB_TOKEN=
# Optional owner/repo: default repository and an allowed repo for automatic reviews.
GITHUB_REPO=
GITHUB_PR_AUTHOR=nathanloehlein
# Repo selector re-scopes the whole dashboard. Map each GitHub repo to the Jira
# project its work lives in; selecting a repo re-queries Jira with that project.
# Comma-separated repo=PROJECT pairs.
REPO_PROJECT_MAP=gdcorp-enm/conversations-web=LEKA,gdcorp-partners/airo-app-builder=AIROBUILD

# Slack browser reader: full PR URLs trigger review runs every five minutes.
SLACK_WATCH_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CHANNEL_ID=
SLACK_CHANNEL_NAME=
# Optional: pin a dedicated cmux browser surface; otherwise discover it.
SLACK_BROWSER_SURFACE=

# Automatically review pending GitHub review requests, once per PR revision.
GITHUB_REVIEW_WATCH_ENABLED=false
