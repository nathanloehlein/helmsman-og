JIRA_BASE_URL=https://godaddy-corp.atlassian.net
JIRA_EMAIL=you@godaddy.com
JIRA_API_TOKEN=
JIRA_PROJECT=AIROBUILD
JIRA_ASSIGNEE=currentUser()
# JIRA_JQL=  # optional full override of the backlog-queue query
GITHUB_TOKEN=
# GITHUB_REPO is now only the default topbar label (falls back to @<author> when unset)
GITHUB_REPO=
GITHUB_PR_AUTHOR=nathanloehlein
# Repo selector re-scopes the whole dashboard. Map each GitHub repo to the Jira
# project its work lives in; selecting a repo re-queries Jira with that project.
# Comma-separated repo=PROJECT pairs.
REPO_PROJECT_MAP=gdcorp-enm/conversations-web=LEKA,gdcorp-partners/airo-app-builder=AIROBUILD
